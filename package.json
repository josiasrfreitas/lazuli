{
  "name": "lazuli",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0 <25 || ^26.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm runtime:check && dotenv -e .env -- turbo run dev --filter=@lazuli/web",
    "dev:worker": "pnpm runtime:check && dotenv -e .env -- turbo run dev --filter=@lazuli/worker",
    "storybook": "pnpm -F @lazuli/storybook dev",
    "storybook:build": "pnpm -F @lazuli/storybook build",
    "start": "pnpm runtime:check && dotenv -e .env -- pnpm -F @lazuli/web start",
    "lint": "eslint eslint.config.js scripts && turbo run lint && pnpm duplication:check",
    "duplication:check": "jscpd apps packages scripts tooling --config jscpd.json",
    "runtime:check": "dotenv -e .env -- node scripts/runtime-check.mjs && node scripts/turbo-env-check.mjs",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:scripts && pnpm test:component-lines && pnpm test:styles && turbo run test",
    "test:scripts": "node --test \"scripts/test/**/*.unit.test.mjs\"",
    "test:component-lines": "node scripts/test-component-lines.mjs",
    "test:styles": "node scripts/test-styles.mjs",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:transport": "turbo run test:transport --concurrency=1",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:transport",
    "test:e2e": "turbo run test:e2e",
    "test:changed-covered": "node scripts/changed-source-covered.mjs",
    "mutate": "turbo run mutate --concurrency=1",
    "mutate:changed": "node scripts/mutate-changed.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "prisma:migrate": "pnpm -F @lazuli/db prisma:migrate",
    "prisma:deploy": "pnpm -F @lazuli/db prisma:deploy",
    "prisma:drift": "pnpm -F @lazuli/db prisma:drift",
    "prisma:seed": "pnpm -F @lazuli/db prisma:seed",
    "db:reset": "pnpm -F @lazuli/db db:reset",
    "bootstrap:worktree": "bash scripts/bootstrap-worktree.sh",
    "seed:gcs": "bash scripts/seed-gcs.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/prettier-config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "jscpd": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "postcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@lazuli/prettier-config"
}
