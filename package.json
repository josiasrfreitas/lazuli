{
  "name": "lazuli",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0 <25"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@lazuli/web",
    "dev:worker": "turbo run dev --filter=@lazuli/worker",
    "lint": "eslint eslint.config.js scripts && turbo run lint && pnpm duplication:check",
    "duplication:check": "jscpd apps packages scripts tooling --config jscpd.json",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\" --ignore-path .gitignore",
    "prisma:migrate": "pnpm -F @lazuli/db prisma:migrate",
    "prisma:seed": "pnpm -F @lazuli/db prisma:seed",
    "db:reset": "pnpm -F @lazuli/db db:reset"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/prettier-config": "workspace:*",
    "eslint": "catalog:",
    "jscpd": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@lazuli/prettier-config"
}
