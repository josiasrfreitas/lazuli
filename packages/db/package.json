{
  "name": "@lazuli/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test": "./test/support/support.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.unit.test.ts\"",
    "test:integration": "node --import tsx --test \"test/**/*.integration.test.ts\"",
    "clean": "rm -rf .turbo dist",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "prisma:seed": "prisma db seed",
    "db:reset": "node --import tsx prisma/reset.ts",
    "mutate": "NODE_ENV=test dotenv -e ../../.env -- stryker run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/stryker-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
