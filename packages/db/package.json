{
  "name": "@lazuli/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./student-health-batch": "./src/student-health-batch.ts",
    "./teacher-responsibility": "./src/teacher-responsibility.ts",
    "./appointment-evidence": "./src/appointment-evidence.ts",
    "./prisma": "./src/generated/prisma/client.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "lint": "lazuli-lint .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-test-tier.mjs unit",
    "test:integration": "node ../../scripts/run-test-tier.mjs integration",
    "clean": "rm -rf .turbo dist",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "prisma-extension-kysely": "catalog:",
    "@lazuli/domain": "workspace:*"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "dotenv-cli": "catalog:",
    "prisma": "catalog:",
    "prisma-kysely": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
