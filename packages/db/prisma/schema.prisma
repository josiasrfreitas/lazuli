model AdmissionCandidate {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  fullName String @map("full_name")
  contactName String? @map("contact_name")
  source String?
  ownerId String? @map("owner_id") @db.Uuid
  nextAction String? @map("next_action")
  nextActionOn DateTime? @map("next_action_on") @db.Date
  owner User? @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  contacts LeadContact[]
  phone String?
  email String?
  notes String?
  status AdmissionStatus @default(WAITING)
  scheduleType ClassScheduleType? @map("schedule_type")
  format ClassFormat?
  stageId String? @map("stage_id") @db.Uuid
  studentId String? @map("student_id") @db.Uuid
  enrollmentId String? @unique @map("enrollment_id") @db.Uuid
  availableUntil DateTime? @map("available_until") @db.Date
  availabilityConfirmedAt DateTime? @default(now()) @map("availability_confirmed_at") @db.Timestamptz
  recordedById String @map("recorded_by_id") @db.Uuid

  stage Stage? @relation(fields: [stageId], references: [id], onDelete: Restrict)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
