generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../src/generated/kysely"
}

datasource db {
  provider = "postgresql"
}

// UUIDEntity is not a Prisma model. Repeat this block on each domain model.
// Better Auth adapter tables and FinanceSettings are the documented exceptions.
//
//   id         String    @id @default(uuid()) @db.Uuid
//   createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
//   updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
//   deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
//
// Domain models are added by their owning issues (P01-P08). Keeping this
// foundation schema model-free prevents P00-03 from pre-empting those designs.

enum UserRole {
  SYSTEM_ADMIN
  ADMIN
  SECRETARY
  TEACHER
  FINANCE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  DROPPED
  SUSPENDED
}

enum DocumentType {
  CPF
  RG
}

enum CatalogStatus {
  ACTIVE
  LEGACY
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassScheduleType {
  REGULAR
  PERSONALIZED
}

enum ClassFormat {
  IN_PERSON
  ONLINE
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
}

enum EnrollmentExitReason {
  COMPLETED
  TRANSFERRED
  DROPPED
  SUSPENDED
  CORRECTION
}

enum ProgressEndReason {
  ADVANCED
  TRANSFERRED
  DROPPED
  SUSPENDED
  CORRECTION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum OrderKind {
  CONTRACT
  TUITION
  ENROLLMENT_FEE
  MATERIAL
  OTHER
}

enum InstallmentAdjustmentType {
  INTEREST
  LATE_FEE
  DISCOUNT
  CORRECTION
}

enum PaymentMethod {
  PIX
  CASH
  TRANSFER
  CARD
  CHEQUE
  BOLETO
  OTHER
}

enum ArtifactKind {
  STUDENT_STATEMENT_PDF
  CLASS_ROSTER_PDF
  ATTENDANCE_SUMMARY_PDF
  OVERDUE_RECEIVABLES_CSV
  MONTHLY_ACCOUNTANT_CSV
  SIGNED_ORDER_PDF
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  email         String    @unique
  name          String
  role          UserRole
  isEnabled     Boolean   @default(true) @map("is_enabled")
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?

  accounts                      Account[]
  sessions                      Session[]
  classesTaught                 Class[]                 @relation("ClassTeacher")
  closedDays                    SchoolClosedDay[]       @relation("SchoolClosedDayCreator")
  attendanceConfirmedSessions   ClassSession[]          @relation("ClassSessionAttendanceConfirmer")
  cancelledClassSessions        ClassSession[]          @relation("ClassSessionCanceller")
  attendanceRecords             Attendance[]            @relation("AttendanceRecorder")
  modifiedAttendance            Attendance[]            @relation("AttendanceModifier")
  scheduledMakeups              Makeup[]                @relation("MakeupScheduler")
  markedMakeups                 Makeup[]                @relation("MakeupAttendanceMarker")
  cancelledMakeups              Makeup[]                @relation("MakeupCanceller")
  createdPayers                 Payer[]                 @relation("PayerCreator")
  updatedPayers                 Payer[]                 @relation("PayerUpdater")
  createdOrders                 Order[]                 @relation("OrderCreator")
  updatedOrders                 Order[]                 @relation("OrderUpdater")
  createdOrderBeneficiaries     OrderBeneficiary[]      @relation("OrderBeneficiaryCreator")
  updatedOrderBeneficiaries     OrderBeneficiary[]      @relation("OrderBeneficiaryUpdater")
  createdInstallments           Installment[]           @relation("InstallmentCreator")
  updatedInstallments           Installment[]           @relation("InstallmentUpdater")
  createdInstallmentAdjustments InstallmentAdjustment[] @relation("InstallmentAdjustmentCreator")
  updatedInstallmentAdjustments InstallmentAdjustment[] @relation("InstallmentAdjustmentUpdater")
  createdPaymentEntries         PaymentEntry[]          @relation("PaymentEntryCreator")
  updatedPaymentEntries         PaymentEntry[]          @relation("PaymentEntryUpdater")
  createdPaymentAllocations     PaymentAllocation[]     @relation("PaymentAllocationCreator")
  updatedPaymentAllocations     PaymentAllocation[]     @relation("PaymentAllocationUpdater")
  updatedFinanceSettings        FinanceSettings[]       @relation("FinanceSettingsUpdater")
  requestedArtifacts            GeneratedArtifact[]     @relation("ArtifactRequester")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
}

model Student {
  id             String        @id @default(uuid()) @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  fullName       String        @map("full_name")
  phone          String?
  email          String?
  birthDate      DateTime?     @map("birth_date") @db.Date
  documentType   DocumentType? @map("document_type")
  documentNumber String?       @map("document_number")
  addressId      String?       @map("address_id") @db.Uuid
  guardianId     String?       @map("guardian_id") @db.Uuid
  status         StudentStatus @default(ACTIVE)
  notes          String?

  address     Address?           @relation(fields: [addressId], references: [id], onDelete: SetNull)
  guardian    Guardian?          @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  enrollments         Enrollment[]
  orderLinks          OrderBeneficiary[]
  contracts           Contract[]
  generatedArtifacts  GeneratedArtifact[]

  @@index([addressId])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Student_full_name_trgm_idx")
  @@index([documentNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Student_document_number_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Student_phone_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Student_email_trgm_idx")
  @@index([guardianId])
}

model Guardian {
  id             String        @id @default(uuid()) @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  fullName       String        @map("full_name")
  relationship   String?
  documentType   DocumentType? @map("document_type")
  documentNumber String?       @map("document_number")
  phone          String?
  email          String?
  addressId      String?       @map("address_id") @db.Uuid

  address  Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  students Student[]

  @@index([addressId])
}

model Address {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  postalCode   String?   @map("postal_code")

  students  Student[]
  guardians Guardian[]
}

// Academic calendar window. Semester setup is the
// trigger for session generation. A start_date <= end_date CHECK and a
// non-overlap exclusion constraint on daterange(start_date, end_date, '[]') live
// in the GRE-22 raw-SQL migration (Prisma cannot express exclusion constraints).
model Semester {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  name      String    @unique
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date

  classes Class[]
}

model SchoolClosedDay {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  date        DateTime  @unique @db.Date
  reason      String
  createdById String?   @map("created_by_id") @db.Uuid

  createdBy User? @relation("SchoolClosedDayCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model ProductLine {
  id           String        @id @default(uuid()) @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz
  key          String        @unique
  name         String        @unique
  status       CatalogStatus @default(ACTIVE)
  portalPrefix String?       @map("portal_prefix")

  tracks Track[]
}

model Class {
  id                      String            @id @default(uuid()) @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?         @map("deleted_at") @db.Timestamptz
  internalCode            String            @unique @map("internal_code")
  teacherId               String            @map("teacher_id") @db.Uuid
  scheduleType            ClassScheduleType @map("schedule_type")
  format                  ClassFormat
  sharedStageId           String?           @map("shared_stage_id") @db.Uuid
  semesterId              String            @map("semester_id") @db.Uuid
  year                    Int
  capacity                Int
  status                  ClassStatus       @default(ACTIVE)
  previousClassId         String?           @map("previous_class_id") @db.Uuid
  portalClassName         String            @map("portal_class_name")
  originalPortalClassName String?           @map("original_portal_class_name")

  teacher       User                @relation("ClassTeacher", fields: [teacherId], references: [id])
  sharedStage   Stage?              @relation(fields: [sharedStageId], references: [id])
  semester      Semester            @relation(fields: [semesterId], references: [id])
  previousClass Class?              @relation("ClassLineage", fields: [previousClassId], references: [id])
  nextClasses   Class[]             @relation("ClassLineage")
  scheduleSlots ClassScheduleSlot[]
  sessions           ClassSession[]
  enrollments        Enrollment[]
  generatedArtifacts GeneratedArtifact[]

  @@index([teacherId])
  @@index([sharedStageId])
  @@index([semesterId])
  @@index([previousClassId])
}

model ClassScheduleSlot {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  classId   String    @map("class_id") @db.Uuid
  weekday   Weekday
  startTime DateTime  @map("start_time") @db.Time
  endTime   DateTime  @map("end_time") @db.Time

  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessions ClassSession[]

  @@unique([classId, weekday, startTime, endTime])
  @@unique([classId, id])
  @@index([classId])
}

model Track {
  id            String        @id @default(uuid()) @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  productLineId String        @map("product_line_id") @db.Uuid
  name          String
  status        CatalogStatus @default(ACTIVE)
  portalPrefix  String?       @map("portal_prefix")

  productLine ProductLine @relation(fields: [productLineId], references: [id], onDelete: Restrict)
  stages      Stage[]

  @@unique([productLineId, name])
}

model Stage {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  trackId      String    @map("track_id") @db.Uuid
  name         String
  internalCode String    @map("internal_code")
  sequence     Int

  track           Track                 @relation(fields: [trackId], references: [id], onDelete: Restrict)
  classes         Class[]
  progressRecords PedagogicalProgress[]

  @@unique([trackId, internalCode])
  @@unique([trackId, sequence])
}

model Enrollment {
  id                     String                @id @default(uuid()) @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?             @map("deleted_at") @db.Timestamptz
  studentId              String                @map("student_id") @db.Uuid
  classId                String                @map("class_id") @db.Uuid
  entryDate              DateTime              @map("entry_date") @db.Date
  exitDate               DateTime?             @map("exit_date") @db.Date
  exitReason             EnrollmentExitReason? @map("exit_reason")
  capacityOverrideReason String?               @map("capacity_override_reason")

  student         Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class           Class                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  progressRecords PedagogicalProgress[]
  attendanceRows  Attendance[]
  makeups         Makeup[]

  @@index([studentId])
  @@index([classId])
}

model PedagogicalProgress {
  id           String             @id @default(uuid()) @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz
  enrollmentId String             @map("enrollment_id") @db.Uuid
  stageId      String             @map("stage_id") @db.Uuid
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime?          @map("end_date") @db.Date
  endReason    ProgressEndReason? @map("end_reason")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@index([enrollmentId])
  @@index([stageId])
}

model ClassSession {
  id                        String             @id @default(uuid()) @db.Uuid
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                 DateTime?          @map("deleted_at") @db.Timestamptz
  classId                   String             @map("class_id") @db.Uuid
  scheduleSlotId            String?            @map("schedule_slot_id") @db.Uuid
  date                      DateTime           @db.Date
  startTime                 DateTime           @map("start_time") @db.Time
  endTime                   DateTime           @map("end_time") @db.Time
  status                    ClassSessionStatus @default(SCHEDULED)
  cancelReason              String?            @map("cancel_reason")
  cancelledAt               DateTime?          @map("cancelled_at") @db.Timestamptz
  cancelledById             String?            @map("cancelled_by_id") @db.Uuid
  attendanceConfirmedAt     DateTime?          @map("attendance_confirmed_at") @db.Timestamptz
  attendanceConfirmedById   String?            @map("attendance_confirmed_by_id") @db.Uuid
  attendanceLastCommittedAt DateTime?          @map("attendance_last_committed_at") @db.Timestamptz
  portalSubmittedAt         DateTime?          @map("portal_submitted_at") @db.Timestamptz

  class                 Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  scheduleSlot          ClassScheduleSlot? @relation(fields: [classId, scheduleSlotId], references: [classId, id], onDelete: Restrict)
  cancelledBy           User?              @relation("ClassSessionCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  attendanceConfirmedBy User?              @relation("ClassSessionAttendanceConfirmer", fields: [attendanceConfirmedById], references: [id], onDelete: Restrict)
  attendanceRows        Attendance[]
  makeups               Makeup[]

  @@index([classId])
  @@index([scheduleSlotId])
  @@index([cancelledById])
  @@index([attendanceConfirmedById])
}

model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  enrollmentId     String           @map("enrollment_id") @db.Uuid
  classSessionId   String           @map("class_session_id") @db.Uuid
  status           AttendanceStatus
  recordedAt       DateTime         @default(now()) @map("recorded_at") @db.Timestamptz
  recordedById     String?          @map("recorded_by_id") @db.Uuid
  notes            String?
  lastModifiedAt   DateTime?        @map("last_modified_at") @db.Timestamptz
  lastModifiedById String?          @map("last_modified_by_id") @db.Uuid

  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  recordedBy     User?        @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  lastModifiedBy User?        @relation("AttendanceModifier", fields: [lastModifiedById], references: [id], onDelete: Restrict)

  // Raw SQL adds the partial unique index on (enrollment_id, class_session_id) where deleted_at IS NULL.
  @@index([enrollmentId])
  @@index([classSessionId])
  @@index([recordedById])
  @@index([lastModifiedById])
}

model Makeup {
  id                   String    @id @default(uuid()) @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz
  originEnrollmentId   String    @map("origin_enrollment_id") @db.Uuid
  targetClassSessionId String    @map("target_class_session_id") @db.Uuid
  scheduledAt          DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz
  scheduledById        String?   @map("scheduled_by_id") @db.Uuid
  reason               String?
  attendedAt           DateTime? @map("attended_at") @db.Timestamptz
  attendedById         String?   @map("attended_by_id") @db.Uuid
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledById        String?   @map("cancelled_by_id") @db.Uuid
  cancellationReason   String?   @map("cancellation_reason")

  originEnrollment   Enrollment   @relation(fields: [originEnrollmentId], references: [id], onDelete: Restrict)
  targetClassSession ClassSession @relation(fields: [targetClassSessionId], references: [id], onDelete: Restrict)
  scheduledBy        User?        @relation("MakeupScheduler", fields: [scheduledById], references: [id], onDelete: Restrict)
  attendedBy         User?        @relation("MakeupAttendanceMarker", fields: [attendedById], references: [id], onDelete: Restrict)
  cancelledBy        User?        @relation("MakeupCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)

  // Raw SQL adds the partial unique index on (origin_enrollment_id, target_class_session_id) where deleted_at IS NULL.
  @@index([originEnrollmentId])
  @@index([targetClassSessionId])
  @@index([scheduledById])
  @@index([attendedById])
  @@index([cancelledById])
}

model FinanceSettings {
  id                     String   @id @default("singleton")
  tuitionCeilingCents     Int?     @map("tuition_ceiling_cents")
  maximumDiscountPct     Decimal? @map("maximum_discount_pct") @db.Decimal(7, 4)
  interestRatePctDaily   Decimal? @map("interest_rate_pct_daily") @db.Decimal(7, 4)
  cancellationFeePct     Decimal? @map("cancellation_fee_pct") @db.Decimal(7, 4)
  materialPriceCents     Int?     @map("material_price_cents")
  interestRatePctMonthly Decimal? @map("interest_rate_pct_monthly") @db.Decimal(7, 4)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedById            String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("FinanceSettingsUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
}

model Payer {
  id             String        @id @default(uuid()) @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  name           String
  taxId          String?       @map("tax_id")
  documentType   DocumentType? @map("document_type")
  documentNumber String?       @map("document_number")
  phone          String?
  email          String?
  createdById    String?       @map("created_by_id") @db.Uuid
  updatedById    String?       @map("updated_by_id") @db.Uuid

  createdBy User?          @relation("PayerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?          @relation("PayerUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  orders    Order[]
  contracts Contract[]
  payments  PaymentEntry[]

  @@index([createdById])
  @@index([updatedById])
}

model Contract {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  payerId   String    @map("payer_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  commandId String? @unique @map("command_id") @db.Uuid
  commandFingerprint String? @map("command_fingerprint")
  agreedOn DateTime? @map("agreed_on") @db.Date
  startsOn DateTime? @map("starts_on") @db.Date
  durationMonths Int? @map("duration_months")
  endsOn DateTime? @map("ends_on") @db.Date
  monthlyAmountCents Int? @map("monthly_amount_cents")
  tuitionCeilingCents Int? @map("tuition_ceiling_cents")
  maximumDiscountPct Decimal? @map("maximum_discount_pct") @db.Decimal(7, 4)
  punctualityDiscountPct Decimal? @map("punctuality_discount_pct") @db.Decimal(7, 4)
  interestRatePctDaily Decimal? @map("interest_rate_pct_daily") @db.Decimal(7, 4)
  interestRatePctMonthly Decimal? @map("interest_rate_pct_monthly") @db.Decimal(7, 4)
  cancellationFeePct Decimal? @map("cancellation_fee_pct") @db.Decimal(7, 4)

  payer   Payer   @relation(fields: [payerId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  orders  Order[]

  @@index([payerId])
  @@index([studentId])
}

model Order {
  id                    String    @id @default(uuid()) @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  payerId               String?   @map("payer_id") @db.Uuid
  contractId            String?   @map("contract_id") @db.Uuid
  kind                  OrderKind
  principalAmountCents  Int       @map("principal_amount_cents")
  startDate             DateTime  @map("start_date") @db.Date
  dueDay                Int       @map("due_day")
  firstDueDate DateTime? @map("first_due_date") @db.Date
  installmentCount Int? @map("installment_count")
  signedOrderArtifactId String?   @map("signed_order_artifact_id") @db.Uuid
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledReason       String?   @map("cancelled_reason")
  createdById           String?   @map("created_by_id") @db.Uuid
  updatedById           String?   @map("updated_by_id") @db.Uuid

  payer         Payer?             @relation(fields: [payerId], references: [id], onDelete: Restrict)
  contract      Contract?          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdBy     User?              @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User?              @relation("OrderUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  beneficiaries      OrderBeneficiary[]
  installments       Installment[]
  generatedArtifacts GeneratedArtifact[]

  @@index([payerId])
  @@index([contractId])
  @@index([createdById])
  @@index([updatedById])
}

model OrderBeneficiary {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  orderId     String    @map("order_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  updatedById String?   @map("updated_by_id") @db.Uuid

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("OrderBeneficiaryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("OrderBeneficiaryUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([orderId, studentId])
  @@index([studentId])
  @@index([createdById])
  @@index([updatedById])
}

model Installment {
  sequenceNumber        Int       @map("sequence_number")
  id                    String    @id @default(uuid()) @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  orderId               String    @map("order_id") @db.Uuid
  amountCents           Int       @map("amount_cents")
  dueDate               DateTime  @map("due_date") @db.Date
  waivedAt              DateTime? @map("waived_at") @db.Timestamptz
  waivedReason          String?   @map("waived_reason")
  overdueD30EmailSentAt DateTime? @map("overdue_d30_email_sent_at") @db.Timestamptz
  createdById           String?   @map("created_by_id") @db.Uuid
  updatedById           String?   @map("updated_by_id") @db.Uuid

  order       Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy   User?                   @relation("InstallmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?                   @relation("InstallmentUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  adjustments InstallmentAdjustment[]
  allocations PaymentAllocation[]

  @@index([orderId])
  @@index([createdById])
  @@index([updatedById])
}

model InstallmentAdjustment {
  id            String                    @id @default(uuid()) @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?                 @map("deleted_at") @db.Timestamptz
  installmentId String                    @map("installment_id") @db.Uuid
  type          InstallmentAdjustmentType
  amountCents   Int                       @map("amount_cents")
  reason        String?
  createdById   String?                   @map("created_by_id") @db.Uuid
  updatedById   String?                   @map("updated_by_id") @db.Uuid

  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("InstallmentAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?       @relation("InstallmentAdjustmentUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([installmentId])
  @@index([createdById])
  @@index([updatedById])
}

model PaymentEntry {
  id                String        @id @default(uuid()) @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz
  payerId           String        @map("payer_id") @db.Uuid
  date              DateTime      @db.Date
  amountCents       Int           @map("amount_cents")
  method            PaymentMethod
  note              String?
  externalReference String?       @map("external_reference")
  createdById       String?       @map("created_by_id") @db.Uuid
  updatedById       String?       @map("updated_by_id") @db.Uuid

  payer       Payer               @relation(fields: [payerId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("PaymentEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?               @relation("PaymentEntryUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([payerId])
  @@index([createdById])
  @@index([updatedById])
}

model PaymentAllocation {
  id             String    @id @default(uuid()) @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  paymentEntryId String    @map("payment_entry_id") @db.Uuid
  installmentId  String    @map("installment_id") @db.Uuid
  amountCents    Int       @map("amount_cents")
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid

  paymentEntry PaymentEntry @relation(fields: [paymentEntryId], references: [id], onDelete: Restrict)
  installment  Installment  @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("PaymentAllocationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?        @relation("PaymentAllocationUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([paymentEntryId, installmentId])
  @@index([installmentId])
  @@index([createdById])
  @@index([updatedById])
}

model GeneratedArtifact {
  id             String       @id @default(uuid()) @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz
  kind           ArtifactKind
  requestedById  String?      @map("requested_by_id") @db.Uuid
  studentId      String?      @map("student_id") @db.Uuid
  classId        String?      @map("class_id") @db.Uuid
  orderId        String?      @map("order_id") @db.Uuid
  storageBucket  String?      @map("storage_bucket")
  storageObject  String?      @map("storage_object")
  contentType    String?      @map("content_type")
  fileName       String?      @map("file_name")
  requestedAt    DateTime     @default(now()) @map("requested_at") @db.Timestamptz
  startedAt      DateTime?    @map("started_at") @db.Timestamptz
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz
  failedAt       DateTime?    @map("failed_at") @db.Timestamptz
  errorCode      String?      @map("error_code")
  errorMessage   String?      @map("error_message")
  expiresAt      DateTime?    @map("expires_at") @db.Timestamptz

  requestedBy User?    @relation("ArtifactRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  student     Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  class       Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([requestedById])
  @@index([studentId])
  @@index([classId])
  @@index([orderId])
  @@index([kind])
  @@map("generated_artifacts")
}
