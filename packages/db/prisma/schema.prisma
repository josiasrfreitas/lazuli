generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// UUIDEntity is not a Prisma model. Repeat this block on each domain model.
// Better Auth adapter tables and FinanceSettings are the documented exceptions.
//
//   id         String    @id @default(uuid()) @db.Uuid
//   createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
//   updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
//   deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
//
// Domain models are added by their owning issues (P01-P08). Keeping this
// foundation schema model-free prevents P00-03 from pre-empting those designs.

enum UserRole {
  ADMIN
  SECRETARY
  TEACHER
  FINANCE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  DROPPED
  SUSPENDED
}

enum DocumentType {
  CPF
  RG
}

enum CatalogStatus {
  ACTIVE
  LEGACY
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassScheduleType {
  REGULAR
  PERSONALIZED
}

enum ClassFormat {
  IN_PERSON
  ONLINE
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
}

enum EnrollmentExitReason {
  COMPLETED
  TRANSFERRED
  DROPPED
  SUSPENDED
  CORRECTION
}

enum ProgressEndReason {
  ADVANCED
  TRANSFERRED
  DROPPED
  SUSPENDED
  CORRECTION
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  email         String    @unique
  name          String
  role          UserRole
  isEnabled     Boolean   @default(true) @map("is_enabled")
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?

  accounts      Account[]
  sessions      Session[]
  classesTaught Class[]   @relation("ClassTeacher")
  closedDays    SchoolClosedDay[] @relation("SchoolClosedDayCreator")
  attendanceConfirmedSessions ClassSession[] @relation("ClassSessionAttendanceConfirmer")
  cancelledClassSessions ClassSession[] @relation("ClassSessionCanceller")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
}

model Student {
  id             String        @id @default(uuid()) @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  fullName       String        @map("full_name")
  phone          String?
  email          String?
  birthDate      DateTime?     @map("birth_date") @db.Date
  documentType   DocumentType? @map("document_type")
  documentNumber String?       @map("document_number")
  addressId      String?       @map("address_id") @db.Uuid
  guardianId     String?       @map("guardian_id") @db.Uuid
  status         StudentStatus @default(ACTIVE)
  notes          String?

  address  Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]

  @@index([addressId])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Student_full_name_trgm_idx")
  @@index([documentNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Student_document_number_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "Student_phone_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Student_email_trgm_idx")
  @@index([guardianId])
}

model Guardian {
  id             String        @id @default(uuid()) @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz
  fullName       String        @map("full_name")
  relationship   String?
  documentType   DocumentType? @map("document_type")
  documentNumber String?       @map("document_number")
  phone          String?
  email          String?
  addressId      String?       @map("address_id") @db.Uuid

  address  Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  students Student[]

  @@index([addressId])
}

model Address {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  postalCode   String?   @map("postal_code")

  students  Student[]
  guardians Guardian[]
}

// Academic calendar window (TECHNICAL_SPEC §4.4, S-CAL-4). Semester setup is the
// trigger for session generation. A start_date <= end_date CHECK and a
// non-overlap exclusion constraint on daterange(start_date, end_date, '[]') live
// in the GRE-22 raw-SQL migration (Prisma cannot express exclusion constraints).
model Semester {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  name      String    @unique
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date

  classes Class[]
}

model SchoolClosedDay {
  id          String    @id @default(uuid()) @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  date        DateTime  @unique @db.Date
  reason      String
  createdById String?   @map("created_by_id") @db.Uuid

  createdBy User? @relation("SchoolClosedDayCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
}

model ProductLine {
  id           String        @id @default(uuid()) @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz
  key          String        @unique
  name         String        @unique
  status       CatalogStatus @default(ACTIVE)
  portalPrefix String?       @map("portal_prefix")

  tracks Track[]
}

model Class {
  id                      String            @id @default(uuid()) @db.Uuid
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?         @map("deleted_at") @db.Timestamptz
  internalCode            String            @unique @map("internal_code")
  teacherId               String            @map("teacher_id") @db.Uuid
  scheduleType            ClassScheduleType @map("schedule_type")
  format                  ClassFormat
  sharedStageId           String?           @map("shared_stage_id") @db.Uuid
  semesterId              String            @map("semester_id") @db.Uuid
  year                    Int
  capacity                Int
  status                  ClassStatus       @default(ACTIVE)
  previousClassId         String?           @map("previous_class_id") @db.Uuid
  portalClassName         String            @map("portal_class_name")
  originalPortalClassName String?           @map("original_portal_class_name")

  teacher       User                @relation("ClassTeacher", fields: [teacherId], references: [id])
  sharedStage   Stage?              @relation(fields: [sharedStageId], references: [id])
  semester      Semester            @relation(fields: [semesterId], references: [id])
  previousClass Class?              @relation("ClassLineage", fields: [previousClassId], references: [id])
  nextClasses   Class[]             @relation("ClassLineage")
  scheduleSlots ClassScheduleSlot[]
  sessions      ClassSession[]
  enrollments   Enrollment[]

  @@index([teacherId])
  @@index([sharedStageId])
  @@index([semesterId])
  @@index([previousClassId])
}

model ClassScheduleSlot {
  id        String    @id @default(uuid()) @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  classId   String    @map("class_id") @db.Uuid
  weekday   Weekday
  startTime DateTime  @map("start_time") @db.Time
  endTime   DateTime  @map("end_time") @db.Time

  class    Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessions ClassSession[]

  @@unique([classId, weekday, startTime, endTime])
  @@unique([classId, id])
  @@index([classId])
}

model Track {
  id            String        @id @default(uuid()) @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  productLineId String        @map("product_line_id") @db.Uuid
  name          String
  status        CatalogStatus @default(ACTIVE)
  portalPrefix  String?       @map("portal_prefix")

  productLine ProductLine @relation(fields: [productLineId], references: [id], onDelete: Restrict)
  stages      Stage[]

  @@unique([productLineId, name])
}

model Stage {
  id           String    @id @default(uuid()) @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  trackId      String    @map("track_id") @db.Uuid
  name         String
  internalCode String    @map("internal_code")
  sequence     Int

  track  Track   @relation(fields: [trackId], references: [id], onDelete: Restrict)
  classes Class[]
  progressRecords PedagogicalProgress[]

  @@unique([trackId, internalCode])
  @@unique([trackId, sequence])
}

model Enrollment {
  id                     String                @id @default(uuid()) @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?             @map("deleted_at") @db.Timestamptz
  studentId              String                @map("student_id") @db.Uuid
  classId                String                @map("class_id") @db.Uuid
  entryDate              DateTime              @map("entry_date") @db.Date
  exitDate               DateTime?             @map("exit_date") @db.Date
  exitReason             EnrollmentExitReason? @map("exit_reason")
  capacityOverrideReason String?               @map("capacity_override_reason")

  student         Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class           Class                   @relation(fields: [classId], references: [id], onDelete: Restrict)
  progressRecords PedagogicalProgress[]

  @@index([studentId])
  @@index([classId])
}

model PedagogicalProgress {
  id           String             @id @default(uuid()) @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?          @map("deleted_at") @db.Timestamptz
  enrollmentId String             @map("enrollment_id") @db.Uuid
  stageId      String             @map("stage_id") @db.Uuid
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime?          @map("end_date") @db.Date
  endReason    ProgressEndReason? @map("end_reason")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  stage      Stage      @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@index([enrollmentId])
  @@index([stageId])
}

model ClassSession {
  id                        String             @id @default(uuid()) @db.Uuid
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                 DateTime?          @map("deleted_at") @db.Timestamptz
  classId                   String             @map("class_id") @db.Uuid
  scheduleSlotId            String?            @map("schedule_slot_id") @db.Uuid
  date                      DateTime           @db.Date
  startTime                 DateTime           @map("start_time") @db.Time
  endTime                   DateTime           @map("end_time") @db.Time
  status                    ClassSessionStatus @default(SCHEDULED)
  cancelReason              String?            @map("cancel_reason")
  cancelledAt               DateTime?          @map("cancelled_at") @db.Timestamptz
  cancelledById             String?            @map("cancelled_by_id") @db.Uuid
  attendanceConfirmedAt     DateTime?          @map("attendance_confirmed_at") @db.Timestamptz
  attendanceConfirmedById   String?            @map("attendance_confirmed_by_id") @db.Uuid
  attendanceLastCommittedAt DateTime?          @map("attendance_last_committed_at") @db.Timestamptz
  portalSubmittedAt         DateTime?          @map("portal_submitted_at") @db.Timestamptz

  class                 Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  scheduleSlot          ClassScheduleSlot?  @relation(fields: [classId, scheduleSlotId], references: [classId, id], onDelete: Restrict)
  cancelledBy           User?              @relation("ClassSessionCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  attendanceConfirmedBy User?              @relation("ClassSessionAttendanceConfirmer", fields: [attendanceConfirmedById], references: [id], onDelete: Restrict)

  @@index([classId])
  @@index([scheduleSlotId])
  @@index([cancelledById])
  @@index([attendanceConfirmedById])
}
