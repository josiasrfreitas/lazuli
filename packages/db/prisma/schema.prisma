  startTime DateTime @map("start_time") @db.Time
  endTime DateTime @map("end_time") @db.Time
  candidate AdmissionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  @@unique([candidateId, weekday, startTime, endTime])
}

model EntryVisit {
  id String @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  candidateId String @map("candidate_id") @db.Uuid
  kind EntryVisitKind
  status EntryVisitStatus @default(SCHEDULED)
  date DateTime @db.Date
  startTime DateTime @map("start_time") @db.Time
  endTime DateTime @map("end_time") @db.Time
  format ClassFormat
  teacherId String? @map("teacher_id") @db.Uuid
  classId String? @map("class_id") @db.Uuid
  scheduleSlotId String? @map("schedule_slot_id") @db.Uuid
  classSessionId String? @map("class_session_id") @db.Uuid
  previousVisitId String? @unique @map("previous_visit_id") @db.Uuid
  notes String?
  cancellationReason String? @map("cancellation_reason")
  recordedById String @map("recorded_by_id") @db.Uuid

  candidate AdmissionCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  teacher User? @relation("EntryVisitTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  recordedBy User @relation("EntryVisitRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  class Class? @relation(fields: [classId], references: [id], onDelete: Restrict)
  scheduleSlot ClassScheduleSlot? @relation(fields: [scheduleSlotId], references: [id], onDelete: Restrict)
  classSession ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  previousVisit EntryVisit? @relation("EntryVisitReschedule", fields: [previousVisitId], references: [id], onDelete: Restrict)
  nextVisit EntryVisit? @relation("EntryVisitReschedule")

  @@index([candidateId, date])
  @@index([teacherId, date, status])
  @@index([classId, date])
}

