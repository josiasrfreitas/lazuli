model AttendanceWindow {
  id                 String                  @id @default(uuid()) @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz
  classSessionId     String                  @map("class_session_id") @db.Uuid
  tokenHash          String                  @unique @map("token_hash")
  format             ClassFormat
  openedAt           DateTime                @map("opened_at") @db.Timestamptz
  expiresAt          DateTime                @map("expires_at") @db.Timestamptz
  openedById         String                  @map("opened_by_id") @db.Uuid
  closedAt           DateTime?               @map("closed_at") @db.Timestamptz
  closedById         String?                 @map("closed_by_id") @db.Uuid
