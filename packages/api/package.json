{
  "name": "@lazuli/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter spec test/*.test.ts",
    "test:db": "DOTENV_CONFIG_PATH=../../.env node --import dotenv/config --import tsx --test --test-concurrency=1 --test-reporter spec test/db/*.test.ts",
    "test:behavior": "DOTENV_CONFIG_PATH=../../.env node --import dotenv/config --import tsx --test --test-concurrency=1 --test-reporter spec test/behavior/*.test.ts",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@lazuli/auth": "workspace:*",
    "@lazuli/db": "workspace:*",
    "@lazuli/domain": "workspace:*",
    "@lazuli/job-contracts": "workspace:*",
    "@lazuli/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "superjson": "catalog:"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
