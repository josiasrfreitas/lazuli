{
  "name": "@lazuli/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-test-tier.mjs unit",
    "test:integration": "node ../../scripts/run-test-tier.mjs integration",
    "test:transport": "node ../../scripts/run-test-tier.mjs transport",
    "clean": "rm -rf .turbo dist",
    "mutate": "NODE_ENV=test dotenv -e ../../.env -- stryker run"
  },
  "dependencies": {
    "@lazuli/auth": "workspace:*",
    "@lazuli/db": "workspace:*",
    "@lazuli/domain": "workspace:*",
    "@lazuli/job-contracts": "workspace:*",
    "@lazuli/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "kysely": "catalog:",
    "superjson": "catalog:"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/stryker-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
