{
  "name": "@lazuli/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter spec test/*.test.ts",
    "test:db": "NODE_ENV=test DOTENV_CONFIG_PATH=../../.env node --import dotenv/config --import tsx --test --test-reporter spec test/db/*.test.ts",
    "test:behavior": "NODE_ENV=test DOTENV_CONFIG_PATH=../../.env node --import dotenv/config --import tsx --test --test-reporter spec test/behavior/*.test.ts",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@lazuli/db": "workspace:*",
    "@lazuli/integrations": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
