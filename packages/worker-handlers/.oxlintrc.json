{
  "$schema": "../../tooling/eslint/node_modules/oxlint/configuration_schema.json",
  "extends": ["../../tooling/eslint/base.json"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@lazuli/ui", "@lazuli/ui/*"],
            "message": "Workers cannot import UI code."
          }
        ]
      }
    ]
  }
}
