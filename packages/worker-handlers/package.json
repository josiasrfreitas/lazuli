{
  "name": "@lazuli/worker-handlers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./calendar": "./src/calendar/process.ts",
    "./sessions": "./src/sessions/process-generation.ts",
    "./enrollment": "./src/enrollment/process-due-actions.ts",
    "./assessment-files": "./src/assessments/process-file.ts",
    "./student-documents": "./src/documents/process.ts"
  },
  "scripts": {
