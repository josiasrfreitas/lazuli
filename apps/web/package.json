{
  "name": "@lazuli/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=4096\" RAYON_NUM_THREADS=${RAYON_NUM_THREADS:-2} next dev --turbopack --port ${LAZULI_WEB_PORT:-3000}",
    "build": "next typegen && pnpm typecheck && RAYON_NUM_THREADS=${RAYON_NUM_THREADS:-2} next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-test-tier.mjs unit",
    "test:e2e": "echo \"[P00-05/P00-06] Playwright e2e not wired yet\" && exit 0",
    "clean": "rm -rf .turbo .next"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.2",
    "@lazuli/api": "workspace:*",
    "@lazuli/auth": "workspace:*",
    "@lazuli/domain": "workspace:*",
    "@lazuli/ui": "workspace:*",
    "@lazuli/validators": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "date-fns": "^4.4.0",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "nuqs": "catalog:",
    "qrcode.react": "^4.2.0",
    "react": "catalog:",
    "react-big-calendar": "^1.20.0",
    "react-dom": "catalog:",
    "recharts": "^3.10.1",
    "superjson": "catalog:",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
