{
  "name": "@lazuli/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port ${LAZULI_WEB_PORT:-3000}",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-test-tier.mjs unit",
    "test:e2e": "echo \"[P00-05/P00-06] Playwright e2e not wired yet\" && exit 0",
    "clean": "rm -rf .turbo .next",
    "mutate": "NODE_ENV=test node ../../scripts/run-unit-mutation.mjs"
  },
  "dependencies": {
    "@lazuli/api": "workspace:*",
    "@lazuli/auth": "workspace:*",
    "@lazuli/domain": "workspace:*",
    "@lazuli/ui": "workspace:*",
    "@lazuli/validators": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "superjson": "catalog:"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/stryker-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
