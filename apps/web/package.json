{
  "name": "@lazuli/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "RAYON_NUM_THREADS=${RAYON_NUM_THREADS:-2} next dev --turbopack --port ${LAZULI_WEB_PORT:-3000}",
    "build": "next typegen && pnpm typecheck && RAYON_NUM_THREADS=${RAYON_NUM_THREADS:-2} next build --turbopack",
    "start": "next start",
    "lint": "lazuli-lint .",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-test-tier.mjs unit",
    "test:e2e": "echo \"[P00-05/P00-06] Playwright e2e not wired yet\" && exit 0",
    "clean": "rm -rf .turbo .next"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.2",
    "@lazuli/api": "workspace:*",
    "@lazuli/auth": "workspace:*",
    "@lazuli/domain": "workspace:*",
    "@lazuli/logging": "workspace:*",
    "@lazuli/ui": "workspace:*",
    "@lazuli/validators": "workspace:*",
    "@sentry/nextjs": "11.14.0",
    "@tanstack/react-query": "catalog:",
    "@tesseract.js-data/por": "^1.0.0",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "date-fns": "^4.4.0",
    "lucide-react": "catalog:",
    "maplibre-gl": "6.18.0",
    "next": "catalog:",
    "nuqs": "catalog:",
    "pdfjs-dist": "^6.4.299",
    "qrcode.react": "4.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "3.10.1",
    "scanic": "1.7.1",
    "superjson": "catalog:",
    "temporal-polyfill": "^1.0.5",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.1.2"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
