{
  "name": "@lazuli/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrumentation.ts src/index.ts",
    "start": "node --enable-source-maps --import tsx --import ./src/instrumentation.ts src/index.ts",
    "build": "echo \"[later] worker bundle/image build\" && exit 0",
    "lint": "lazuli-lint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist",
    "test": "node ../../scripts/run-test-tier.mjs unit"
  },
  "dependencies": {
    "@lazuli/db": "workspace:*",
    "@lazuli/domain": "workspace:*",
    "@lazuli/integrations": "workspace:*",
    "@lazuli/job-contracts": "workspace:*",
    "@lazuli/logging": "workspace:*",
    "@lazuli/worker-handlers": "workspace:*",
    "@sentry/node": "11.14.0"
  },
  "devDependencies": {
    "@lazuli/eslint-config": "workspace:*",
    "@lazuli/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
