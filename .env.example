# Lazuli environment template — copy to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is gitignored; only this template is committed. Defaults below match
# the local Docker Compose stack (docker-compose.yml). No Sentry in MVP.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
LAZULI_ENV=local
# Class organization UI is hidden until explicitly enabled.
LAZULI_CLASS_ORGANIZATION_ENABLED=false
# Public base URL of the web app (used by Better Auth callbacks, email links).
APP_URL=http://localhost:3000
# Per-worktree ports set by `pnpm workspace:setup light`; Web requires profile `full`.
LAZULI_WEB_PORT=3000
LAZULI_STORYBOOK_PORT=6006
# Optional fixed development-only delay for every tRPC request. Zero/absent disables delay + log.
# TRPC_DEV_DELAY_MS=150

# ---------------------------------------------------------------------------
# Database — Postgres 16 (Docker Compose service `postgres`, port 5432)
# Per worktree: intended lazuli_<identity> database (set by workspace setup).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://lazuli:lazuli@localhost:5432/lazuli_main?schema=public

# ---------------------------------------------------------------------------
# Better Auth — https://better-auth.com
# ---------------------------------------------------------------------------
# Generate a secret: `openssl rand -base64 32`

BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email — Resend in prod, Mailpit locally (D-0007)
# Local: SMTP on 1025, read captured mail at http://localhost:8025
# Leave RESEND_API_KEY empty locally to route through Mailpit SMTP.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Lazuli <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025

# ---------------------------------------------------------------------------
# Hatchet — Cloud engine in prod; Hatchet Lite locally (docker-compose)
# Local dashboard: http://localhost:8888 — create a token there (or via the
# `hatchet-lite` admin CLI) and paste it below. gRPC engine is on :7077.
# ---------------------------------------------------------------------------
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=localhost:7077
# Local Hatchet Lite serves plaintext gRPC; use `tls` against Hatchet Cloud.
HATCHET_CLIENT_TLS_STRATEGY=none
# Optional stable namespace override; defaults to a hash of the database host/name.
# Web and Worker must use the same value. Worktrees are isolated automatically.
HATCHET_CLIENT_NAMESPACE=

# ---------------------------------------------------------------------------
# Amazon S3 — private application files (decision 0025)
# Local service: docker compose up -d s3. Workspace setup sets S3_BUCKET;
# leave empty to derive an isolated local bucket from DATABASE_URL.
# Production: set S3_BUCKET and AWS_REGION, omit S3_ENDPOINT, use an IAM role.
# ---------------------------------------------------------------------------
S3_BUCKET=
S3_ENDPOINT=http://localhost:9090
AWS_REGION=us-east-1
# Amazon Location uses the permitted managed-infrastructure region.
AWS_LOCATION_REGION=us-east-2
# For local lookup, authenticate this profile with aws login first.
AWS_PROFILE=lazuli

# ---------------------------------------------------------------------------
# Legacy Google Cloud Storage — retained until bootstrap migration
# Local: fake-gcs-server via Docker Compose (port 4443). Per worktree:
# lazuli-<branch_slug> bucket (set by worktree bootstrap). STORAGE_EMULATOR_HOST
# points the GCP SDK at the emulator; leave GOOGLE_APPLICATION_CREDENTIALS empty
# locally unless testing signed URLs.
# ---------------------------------------------------------------------------
GCS_PROJECT_ID=lazuli-local
GCS_ARTIFACTS_BUCKET=lazuli-main
STORAGE_EMULATOR_HOST=http://localhost:4443
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Portal (SGF) submission (D-0023) — shared school master credential.
# In prod these resolve from GCP Secret Manager; placeholders only here.
# ---------------------------------------------------------------------------
PORTAL_BASE_URL=
PORTAL_MASTER_USERNAME=
PORTAL_MASTER_PASSWORD=
