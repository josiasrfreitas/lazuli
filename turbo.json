{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "APP_URL",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "AWS_PROFILE",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "HATCHET_CLIENT_API_URL",
    "HATCHET_CLIENT_NAMESPACE",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "EMAIL_FROM",
    "GCS_ARTIFACTS_BUCKET",
    "GCS_PROJECT_ID",
    "GOOGLE_APPLICATION_CREDENTIALS",
    "STORAGE_EMULATOR_HOST",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "HATCHET_CLIENT_HOST_PORT",
    "HATCHET_CLIENT_TLS_STRATEGY",
    "HATCHET_CLIENT_TOKEN",
    "LAZULI_STORYBOOK_PORT",
    "LAZULI_WEB_PORT",
    "NODE_ENV",
    "PORTAL_BASE_URL",
    "PORTAL_MASTER_PASSWORD",
    "PORTAL_MASTER_USERNAME",
    "RESEND_API_KEY",
    "SMTP_HOST",
    "SMTP_PORT",
    "TRPC_DEV_DELAY_MS"
  ],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:transport": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#lint:root": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#duplication:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#test:scripts": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#test:component-lines": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "//#test:styles": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
